# Alamat backend NETRA AI (FastAPI).
# Lokal (saat menjalankan uvicorn di komputer): http://localhost:8000
# Produksi: URL publik backend, mis. https://netra-ai-api.onrender.com
#
# Salin file ini menjadi .env.local untuk pengembangan lokal,
# atau set variabel ini di dashboard Netlify (Site settings > Environment).
# Catatan: halaman "Unggah & Analisis" juga menyediakan input URL manual,
# jadi variabel ini opsional.
NEXT_PUBLIC_API_URL=http://localhost:8000
